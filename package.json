{
  "name": "bga-tichu",
  "version": "1.0.0",
  "description": "Tichu for BoardGameArena",
  "main": "tichu.js",
  "scripts": {
    "test:unit": "php -d error_reporting=24575 ./vendor/bin/phpunit --do-not-cache-result tests",
    "test:integration": "bash local/mysql-ctl.sh ensure && php local/integration-tests.php",
    "test:contracts": "php local/check-contracts.php",
    "phpstan": "php -d memory_limit=512M ./vendor/bin/phpstan analyse",
    "test:race": "bash local/mysql-ctl.sh ensure && php local/race-tests.php",
    "test": "npm run test:unit && npm run test:integration",
    "local": "bash local/mysql-ctl.sh ensure && php -S 127.0.0.1:8080 local/router.php",
    "mysql:start": "bash local/mysql-ctl.sh start",
    "mysql:stop": "bash local/mysql-ctl.sh stop",
    "mysql:status": "bash local/mysql-ctl.sh status",
    "mysql:reset": "bash local/mysql-ctl.sh reset",
    "compile": "tsc -p src",
    "watch": "tsc --watch -p src",
    "format": "npx prettier --write .",
    "bundle": "esbuild ./dist/tichu.js --bundle --outfile=tichu.js --target=es5 && esbuild ./src/elements/elements.ts --bundle >> tichu.js",
    "build": "npm test && npm run compile && npm run bundle",
    "deploy:sftp": "bash local/sftp-sync.sh",
    "deploy:sftp:all": "bash local/sftp-sync.sh --all"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bro314/tichu.git"
  },
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/bro314/tichu/issues"
  },
  "homepage": "https://github.com/bro314/tichu#readme",
  "devDependencies": {
    "@prettier/plugin-php": "^0.26.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.10.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "lit": "^3.3.3",
    "rxjs": "^7.8.2"
  }
}
